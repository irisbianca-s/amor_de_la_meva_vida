<!DOCTYPE html>
<html>
<head>
<link href='https://fonts.googleapis.com/css?family=Beth Ellen' rel='stylesheet'>
    <title>Cartas para os Pirinéus</title>
    <style>
        body { background-image: url("https://i.pinimg.com/736x/5c/cb/39/5ccb3971edfad3fa0da2ff6ae677add2.jpg"); background-size: 110%; background-repeat: repeat-y; font-family: 'Beth Ellen'; text-align: left; padding: 6% 3% 6% 3%; color: black;}
        .carta { background-image: url("data:image/jpeg;base64,"); background-size: 100%; background-repeat: repeat-y; padding: 3% 4% 13% 13%; border-radius: 2px; box-shadow: 0 6px 10px rgba(0,0,0,0.2); max-width: 430px; height: 1000px; }
        h1 { color: black; font-size: 20px; }
        p { font-size: 14px; line-height: 1.4; white-space: pre-line; color: #16264c; }
        .date { font-size: 10px; margin: 0px 0px 20px; text-align: right; color: #6d597a; }
    </style>
</head>

<body>
    <div class="carta">
        <div class="date" id="data-atual"></div>
        <p id="saudacao">Querido Joan,</p>
        <p id="mensagem">A encontrar a carta...</p>
        <p id="despedida"><br>Da tua mais amada, <br>Íris Bianca.</p>
    </div>

    <script>
        const cartas = {
        	"2026-06-10": "Só existem duas coisas mais solitária do que uma noite nas montanhas: os meus braços na tua ausência. Estou a guardar a covinha no meu peito para quando puderes voltar a unir o teu coração ao meu. Normalmente quando os gajos têm no perfil do Hinge que gostam de caminhadas e viajar acabam por não gostar de verdade - é uma coisa que se diz para impressionar. Mas agora que te conheço e vejo o quão aventureiro tu és passo a perceber um bocadinho melhor o fado :)",
            "2026-06-11": "Bom dia! Hoje o caminho deve ser longo, mas a vista vai valer a pena. Beijo enorme!",
            "2026-06-12": "Mais um dia! Lembra-te de beber água e tirar muitas fotos para me mostrares depois. Amo-te!",
        };

        function carregarCarta() {

            const hoje = new Date();
            const ano = hoje.getFullYear();
            const mes = String(hoje.getMonth() + 1).padStart(2, '0');
            const dia = String(hoje.getDate()).padStart(2, '0');
            const dataFormatada = `${ano}-${mes}-${dia}`;

            document.getElementById('data-atual').innerText = hoje.toLocaleDateString('pt-PT', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

            const tituloElement = document.getElementById('titulo');
            const mensagemElement = document.getElementById('mensagem');

            if (cartas[dataFormatada]) {
                mensagemElement.innerText = cartas[dataFormatada];
            } else {
                tituloElement.innerText = "Espreita mais tarde!";
                mensagemElement.innerText = "Ainda não há uma carta para o dia de hoje, ou a caminhada começou cedo demais! Guarda as energias para a subida.";
            }
        }
        carregarCarta();
    </script>
</body>
</html>
